# ================================================================
# CORVIT AI ADVISOR — ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================
# Copy this file to .env and insert your real API keys.
# NEVER commit .env to GitHub or any public repository.

# Groq API Key (Primary Provider)
GROQ_API_KEY=your_groq_api_key_here

# AI Model Selection
# Primary: High-performance reasoning model
PRIMARY_MODEL=openai/gpt-oss-120b
# Fallback: Instant resilient model for auto-failover
FALLBACK_MODEL=llama-3.1-8b-instant

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8000

# Research Module Settings
# Enables online fact-checking for temporal queries (e.g. 2025/2026 batches)
ENABLE_ONLINE_RESEARCH=true
